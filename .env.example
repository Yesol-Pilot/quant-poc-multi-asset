# ────────────────────────────────────────────────────────
# quant-poc-multi-asset — Environment Variables
# Copy to .env.local (gitignored) and fill in real values
# ────────────────────────────────────────────────────────

# ─── Supabase (Pro tier, already active) ─────────
# Get from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-side only (DO NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Vercel (Pro tier, already active) ─────────
# Auto-set by Vercel during deployment
# VERCEL_URL=
# VERCEL_GIT_COMMIT_SHA=

# ─── Gemini API ($100 budget) ─────────
# Get from Google AI Studio → API Keys
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ─── KIS Developers (모의투자 mock account) ─────────
# Get from apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443  # MOCK ONLY, never use production URL

# ─── IBKR TWS Paper Account ─────────
# Local TWS / IB Gateway, paper port 7497 (NEVER 7496 = live)
IBKR_HOST=localhost
IBKR_PORT=7497  # PAPER ONLY, CI guards prevent 7496
IBKR_CLIENT_ID=1

# ─── GitHub (PAT for CI / API access) ─────────
GITHUB_TOKEN=ghp_...

# ─── Analytics ─────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ─── Telegram (alerts) ─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Mode (CRITICAL) ─────────
TRADING_MODE=paper  # MUST always be 'paper' in Phase 1
NODE_ENV=development
